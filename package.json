{
  "name": "portfolio",
  "description": "Personal portfolio — a static site, one page and a blog, built with Astro and Tailwind CSS",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "author": "Timur Jalilov",
  "homepage": "https://timurjalilov.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TimurJ/portfolio.git"
  },
  "keywords": [
    "astro",
    "tailwindcss",
    "portfolio",
    "static-site"
  ],
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24.16.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "eslint .",
    "typecheck": "astro check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "node --test src/lib/readingTime.test.ts src/lib/dates.test.ts",
    "test:e2e": "playwright test",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:unit && pnpm build && pnpm test:e2e",
    "deploy": "astro build && wrangler deploy"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.2",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@fontsource/archivo": "^5.3.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.13.5",
    "eslint": "^10.10.0",
    "eslint-plugin-astro": "^3.2.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "prettier": "^3.9.7",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "satori": "^0.33.4",
    "sharp": "^0.35.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "wrangler": "4.132.0"
  }
}
