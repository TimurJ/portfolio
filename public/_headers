# Everything under /_astro/ is content-hashed by the build, so it can be
# cached forever; HTML keeps the platform default (max-age=0, must-revalidate).
/_astro/*
  Cache-Control: public, max-age=31556952, immutable

# Security headers on every path (matching rules combine, so hashed assets get
# these plus the cache rule above). A CSP is deferred until launch-freeze: the
# HTML ships inline scripts/styles by design — see docs/launch-checklist.md.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
