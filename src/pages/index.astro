---
import Blog from "../components/Blog.astro";
import Contact from "../components/Contact.astro";
import Experience from "../components/Experience.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Base from "../layouts/Base.astro";
import { name, role } from "../lib/site";
---

<Base
  title={`${name}, ${role}`}
  description={`${role} in London building the frontends of real-time trading platforms — currently leading the team behind an energy-commodities trading terminal at Onyx Capital Group.`}
>
  <Header />
  {/* id: Header's skip link targets it. */}
  <main id="main">
    <Hero />
    <Experience />
    <Blog />
    <Contact />
  </main>
  <Footer />
</Base>
