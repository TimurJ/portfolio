---
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";
import { render } from "astro:content";

import DotLabel from "../../components/DotLabel.astro";
import Footer from "../../components/Footer.astro";
import Header from "../../components/Header.astro";
import Base from "../../layouts/Base.astro";
import { formatLongDate, isoDate } from "../../lib/dates";
import { homeHrefOf } from "../../lib/nav";
import { getPosts, readingTimeOf } from "../../lib/posts";
import { name } from "../../lib/site";

export const getStaticPaths = (async () => {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { post } = Astro.props;
const { title, description, pubDate } = post.data;
const { Content } = await render(post);
const minutes = readingTimeOf(post);
---

<Base
  title={`${title} — ${name}`}
  description={description}
  article={{ headline: title, publishedTime: pubDate }}
>
  <Header />
  {/* id: Header's skip link targets it — the same contract as index.astro. */}
  <main id="main" class="mx-auto max-w-page px-(--gutter)">
    <article class="article grid items-start">
      {
        /* Mirrors .blog-meta on the row the reader clicked: same column, same
           date-then-duration order, same collapse to a line above the title. */
      }
      <div class="article-meta text-muted">
        <DotLabel>
          <time datetime={isoDate(pubDate)}>{formatLongDate(pubDate)}</time>
        </DotLabel>
        <span>{minutes} min read</span>
      </div>
      {
        /* min-w-0 is load-bearing: a <pre> with overflow-x: auto inside a grid
           track otherwise widens the track to its longest line. */
      }
      <div class="flex min-w-0 flex-col">
        <header class="article-head flex flex-col border-b border-hair">
          <DotLabel
            large
            class="text-[11px] tracking-[0.12em] text-accent-text uppercase"
          >
            Blog
          </DotLabel>
          <h1
            class="article-title max-w-[24ch] leading-[1.05] font-normal tracking-[-0.03em]"
          >
            {title}
          </h1>
          <p class="article-lede max-w-[62ch] text-pretty text-muted">
            {description}
          </p>
        </header>
        <div class="prose max-w-[70ch]"><Content /></div>
        {
          /* 404's idiom: the underlined CTA, no arrow — ↓ and ↗ are reserved
             for in-page and external links. */
        }
        <a
          href={homeHrefOf("blog")}
          class="article-back self-start border-b border-accent-text/40 pb-0.5 text-meta text-accent-text hover:border-accent-text"
        >
          Back to blog
        </a>
      </div>
    </article>
  </main>
  <Footer />
</Base>

<style>
  /* Tier rules per docs/architecture.md; 1100/900/700 =
     laptop/tablet/phone. Sizes the design has no page for are recorded in
     docs/design.md (article body and code). */

  .article {
    /* = .blog-row: the meta and the text land where the row's did. */
    grid-template-columns: minmax(0, 3fr) minmax(0, 10fr);
    column-gap: 32px;
    padding-block: clamp(28px, 5vh, 58px) clamp(40px, 8vh, 96px);
  }
  .article-meta {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-top: 5px;
    font-size: var(--text-body);
    line-height: 1.2;
  }
  .article-head {
    gap: 18px;
    padding-bottom: clamp(24px, 4vh, 40px);
  }
  .article-title {
    /* = .intro-title */
    font-size: clamp(28px, 4.4vh, 50px);
  }
  .article-lede {
    font-size: var(--text-body);
    line-height: 1.6;
  }
  .prose {
    padding-top: clamp(24px, 4vh, 40px);
    font-size: 17px;
    line-height: 1.65;
  }
  .article-back {
    margin-top: clamp(32px, 5vh, 56px);
  }

  /* Rendered markdown carries no scope attribute, so everything below reaches
     it through :global() from the .prose wrapper, which does. */
  .prose :global(h2) {
    margin-top: 2.2em;
    /* = .blog-title */
    font-size: clamp(20px, 2vw, 30px);
    line-height: 1.15;
    letter-spacing: -0.02em;
  }
  .prose :global(h3) {
    margin-top: 1.8em;
    font-size: clamp(17px, 1.3vw, 21px);
    line-height: 1.2;
    letter-spacing: -0.01em;
  }
  .prose :global(p),
  .prose :global(ul),
  .prose :global(ol),
  .prose :global(blockquote) {
    margin-top: 1.1em;
    text-wrap: pretty;
  }
  .prose :global(h2 + p),
  .prose :global(h3 + p) {
    margin-top: 0.8em;
  }
  /* The wrapper's padding already separates the body from the header rule. */
  .prose :global(> :first-child) {
    margin-top: 0;
  }
  /* Preflight strips list markers; a post's lists get them back. */
  .prose :global(ul) {
    list-style: disc;
    padding-left: 1.4em;
  }
  .prose :global(ol) {
    list-style: decimal;
    padding-left: 1.4em;
  }
  .prose :global(li) {
    margin-top: 0.35em;
  }
  .prose :global(li::marker) {
    color: var(--muted);
  }
  /* The base `a` rule (ink, no underline) would leave a link in running text
     indistinguishable from the paragraph, so links take the site's underlined
     CTA idiom; base a:hover already supplies the accent colour. */
  .prose :global(a) {
    color: var(--accent-text);
    border-bottom: 1px solid
      color-mix(in oklab, var(--accent-text) 40%, transparent);
  }
  @media (hover: hover) {
    .prose :global(a:hover) {
      border-bottom-color: var(--accent-text);
    }
  }
  .prose :global(blockquote) {
    padding-left: 18px;
    border-left: 1px solid var(--line);
    color: var(--muted);
  }
  .prose :global(hr) {
    margin-block: 2.5em;
    border: 0;
    border-top: 1px solid var(--hair);
  }
  .prose :global(code) {
    font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
    font-size: 0.9em;
  }
  .prose :global(:not(pre) > code) {
    padding: 1px 5px;
    border: 1px solid var(--hair);
  }
  /* Shiki, dual theme. Astro renames the class to .astro-code and leaves
     overflow-x: auto and tabindex="0" inline; with defaultColor: false the
     <pre> and every token <span> carry only --shiki-light/--shiki-dark custom
     properties, so the page's own theme attribute chooses the side. */
  .prose :global(.astro-code) {
    margin-top: 1.4em;
    padding: 18px 20px;
    border: 1px solid var(--hair);
    font-size: 13.5px;
    line-height: 1.55;
    color: var(--shiki-light);
    background-color: var(--shiki-light-bg);
  }
  .prose :global(.astro-code span) {
    color: var(--shiki-light);
  }
  :global([data-theme="dark"]) .prose :global(.astro-code) {
    color: var(--shiki-dark);
    background-color: var(--shiki-dark-bg);
  }
  :global([data-theme="dark"]) .prose :global(.astro-code span) {
    color: var(--shiki-dark);
  }
  /* The one opt-in to the theme fade (global.css states the opt-out contract
     the components follow): these colours are fixed inline values outside the
     eleven tokens, so they would snap while the page eases. A transition here
     is safe for exactly the reason the components must exclude theirs — the
     target does not move. */
  :global(html.theme-switching) .prose :global(.astro-code),
  :global(html.theme-switching) .prose :global(.astro-code span) {
    transition:
      color var(--theme-fade) ease,
      background-color var(--theme-fade) ease;
  }

  /* Laptop: tighter rhythm and body. */
  @media (width < 1100px) {
    .article {
      padding-block: 24px 64px;
    }
    .article-title {
      font-size: 38px;
    }
    .prose {
      font-size: 16px;
    }
    .prose :global(h2) {
      font-size: 22px;
    }
  }

  /* Tablet: single column; the meta becomes a line above the title. */
  @media (width < 900px) {
    .article {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 16px;
    }
    .article-meta {
      flex-direction: row;
      align-items: center;
      gap: 18px;
      margin-top: 0;
      font-size: 14px;
    }
  }

  /* Phone: body at the site's base size, code steps down. */
  @media (width < 700px) {
    .article-title {
      font-size: 28px;
    }
    .prose {
      font-size: var(--text-body);
      line-height: 1.6;
    }
    .prose :global(h2) {
      font-size: 20px;
    }
    .prose :global(.astro-code) {
      padding: 14px 16px;
      font-size: 12.5px;
    }
  }
</style>
