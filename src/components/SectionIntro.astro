---
import BookCallCta from "./BookCallCta.astro";
import DotLabel from "./DotLabel.astro";

interface Props {
  eyebrow: string;
  title: string;
  blurb: string;
  /** id for the <h2>, so the consuming section can name itself by it. Required
      rather than optional: an unnamed section is not a landmark. */
  titleId: string;
  /** Tightens the intro below 460px, for sections that must fit one phone screen. */
  condensed?: boolean;
  /** The page-closing CTA variant (Contact): roomier padding, larger centered
      aside, single column from the phone tier. Never combined with condensed. */
  closer?: boolean;
  /** Extra utilities for the consumer's context (placement, sizing). */
  class?: string;
}

const {
  eyebrow,
  title,
  blurb,
  titleId,
  condensed = false,
  closer = false,
  class: className,
} = Astro.props;
---

<div class:list={["intro grid", { condensed, closer }, className]}>
  <div class="flex flex-col gap-[18px]">
    <DotLabel
      large
      class="text-[11px] tracking-[0.12em] text-accent-text uppercase"
    >
      {eyebrow}
    </DotLabel>
    <h2
      id={titleId}
      class="intro-title max-w-[15ch] leading-[1.05] font-normal tracking-[-0.03em]"
    >
      {title}
    </h2>
  </div>
  <div
    class:list={[
      "intro-aside flex flex-col",
      closer ? "self-center" : "self-start",
    ]}
  >
    <p class="intro-blurb max-w-[42ch] text-pretty text-muted">{blurb}</p>
    <slot name="cta"><BookCallCta class="self-start" /></slot>
  </div>
</div>

<style>
  /* Tier rules per docs/architecture.md; 1100/700/460 =
     laptop/phone/phone-sm, and 400 is this intro's own narrowest tier. The
     .closer overrides win over the markup utilities they replace because
     component styles are unlayered while Tailwind's utilities are layered. */

  .intro {
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: 40px;
    padding: clamp(20px, 4vh, 44px) var(--gutter) clamp(24px, 4.5vh, 52px);
  }
  .intro-title {
    font-size: clamp(28px, 4.4vh, 50px);
  }
  .intro-aside {
    justify-self: end;
    gap: 22px;
    margin-top: 34px;
  }
  .intro-blurb {
    font-size: var(--text-body);
    line-height: 1.6;
  }
  .intro.closer {
    padding: clamp(40px, 9vh, 110px) var(--gutter) clamp(40px, 8vh, 96px);
  }
  .closer .intro-title {
    max-width: 14ch;
    font-size: clamp(30px, 5.2vh, 58px);
    line-height: 1.02;
  }
  .closer .intro-aside {
    gap: 26px;
    margin-top: 0;
  }

  /* Laptop: even column split, tighter spacing and type. */
  @media (width < 1100px) {
    .intro {
      grid-template-columns: minmax(0, 6fr) minmax(0, 6fr);
      gap: 28px;
      padding: 20px var(--gutter) 22px;
    }
    .intro-title {
      font-size: 38px;
    }
    .intro-aside {
      gap: 14px;
      margin-top: 26px;
    }
    .intro-blurb {
      font-size: 13.5px;
      line-height: 1.5;
    }
    .intro.closer {
      padding: 40px var(--gutter);
    }
    .closer .intro-title {
      font-size: 40px;
    }
    .closer .intro-aside {
      gap: 26px;
      margin-top: 0;
    }
  }

  /* Phone: the intro condenses so the section header stays compact; the
     closer variant instead goes single-column and keeps its larger rhythm. */
  @media (width < 700px) {
    .intro {
      gap: 12px;
      padding: 14px var(--gutter) 16px;
    }
    .intro-title {
      font-size: 28px;
    }
    .intro-aside {
      gap: 10px;
      margin-top: 0;
    }
    .intro-blurb {
      font-size: 13px;
      line-height: 1.45;
    }
    .intro.closer {
      grid-template-columns: minmax(0, 1fr);
      gap: 20px;
      padding: 32px var(--gutter);
    }
    .closer .intro-title {
      font-size: 30px;
    }
    .closer .intro-aside {
      justify-self: start;
      gap: 26px;
    }
    .closer .intro-blurb {
      font-size: 13.5px;
      line-height: 1.5;
    }
  }

  /* Opt-in tightening for sections that must fit one small-phone screen. */
  @media (width < 460px) {
    .intro.condensed {
      gap: 10px;
      padding: 12px var(--gutter) 14px;
    }
    .intro.condensed .intro-title {
      font-size: 26px;
    }
  }

  /* Narrowest phones: stack the blurb under the heading. */
  @media (width < 400px) {
    .intro {
      grid-template-columns: minmax(0, 1fr);
    }
    .intro-aside {
      justify-self: start;
    }
  }
</style>
