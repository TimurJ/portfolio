---
import { hrefOf, sections } from "../lib/nav";
import { email, mailto, socials } from "../lib/site";

const year = new Date().getFullYear();

/* The footer doesn't link to the section it closes the page with. */
const footerNav = sections.filter(({ id }) => id !== "contact");

const footerLinkClass = "text-bg hover:text-accent-on-ink";
const footerLabelClass = "footer-label uppercase opacity-(--on-ink-dim)";
---

<footer id="site-footer" class="bg-ink text-bg">
  <div class="footer-inner mx-auto w-full max-w-page">
    <a
      href={mailto}
      class:list={[
        "footer-email inline-block leading-none tracking-[-0.04em]",
        footerLinkClass,
      ]}
    >
      {email}
    </a>
    <div class="footer-cols grid border-t border-bg/24">
      {
        /* Each column's heading names its own group, so the links aren't six
          loose anchors in `contentinfo`: the first is a second navigation
          landmark (distinguished from Header's by its label), the second a
          plain group, since a list of profile links isn't site navigation. */
      }
      <nav aria-labelledby="footer-nav-label" class="flex flex-col gap-3.5">
        <span id="footer-nav-label" class={footerLabelClass}>Navigate</span>
        {
          footerNav.map(({ id, label }) => (
            <a href={hrefOf(id)} class={footerLinkClass}>
              {label}
            </a>
          ))
        }
      </nav>
      <div
        role="group"
        aria-labelledby="footer-elsewhere-label"
        class="flex flex-col gap-3.5"
      >
        <span id="footer-elsewhere-label" class={footerLabelClass}>
          Elsewhere
        </span>
        {
          socials.map(({ href, label }) => (
            <a href={href} class={footerLinkClass}>
              {label} ↗
            </a>
          ))
        }
        {
          /* No CV hosted yet — becomes a link like the two above once it is.
            No ↗ until then: the arrow means "leaves the page", and this one
            goes nowhere (same reasoning as Blog's non-link "Read article"). */
        }
        <span>Résumé</span>
      </div>
      <div class="flex flex-col gap-3.5">
        <span class={footerLabelClass}>Based in</span>
        <span class="opacity-(--on-ink-mid)">London, UK</span>
        <span class="opacity-(--on-ink-mid)">Open to remote</span>
      </div>
    </div>
    <div
      class="footer-legal flex flex-wrap justify-between opacity-(--on-ink-dim)"
    >
      <span>
        <span class="legal-long">
          © {year} Timur Jalilov. All rights reserved.
        </span>
        <span class="legal-short">© {year} Timur Jalilov</span>
      </span>
      <span>
        <span class="legal-long">Designed and built in London</span>
        <span class="legal-short">Built in London</span>
      </span>
    </div>
  </div>
</footer>

<style>
  /* Per-tier rules live here per the styling policy (docs/architecture.md);
     1100/700 = laptop/phone, and 410 is this footer's own narrowest tier.
     Naming the tier rather than spelling the token: Tailwind's scanner reads
     this file, and a --breakpoint-* written even in a comment makes it emit
     that token into :root, referenced by nothing. */

  .footer-inner {
    padding: clamp(32px, 5vh, 56px) var(--gutter) clamp(20px, 3vh, 30px);
  }
  .footer-email {
    font-size: clamp(28px, 6.2vw, 92px);
  }
  .footer-cols {
    /* The empty trailing track is the design's spacer: it keeps the three
       columns hugging the left edge at 1/4.2 of the row each. */
    grid-template-columns: repeat(3, minmax(0, 1fr)) minmax(0, 1.2fr);
    gap: 32px;
    margin-top: clamp(36px, 6vh, 72px);
    padding-top: 26px;
    font-size: var(--text-meta);
  }
  .footer-label {
    font-size: 11px;
    letter-spacing: 0.12em;
  }
  .footer-legal {
    gap: 16px;
    margin-top: clamp(28px, 4vh, 48px);
    font-size: 12px;
  }
  .legal-short {
    display: none;
  }

  /* Laptop: three-column footer, viewport-scaled email. */
  @media (width < 1100px) {
    .footer-cols {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 26px 24px;
      font-size: 12.5px;
    }
    .footer-email {
      font-size: 7.1vw;
      white-space: nowrap;
    }
  }

  /* Phone: smaller footer type, one-line legal row. */
  @media (width < 700px) {
    .footer-inner {
      padding: 32px var(--gutter) 22px;
    }
    .footer-email {
      font-size: clamp(22px, 8.4vw, 40px);
    }
    .footer-cols {
      gap: 20px 14px;
      margin-top: 32px;
      font-size: 11.5px;
    }
    .footer-label {
      font-size: 10px;
      letter-spacing: 0.08em;
    }
    .footer-legal {
      flex-wrap: nowrap;
      gap: 12px;
      font-size: 11.5px;
    }
    .footer-legal > span {
      white-space: nowrap;
    }
  }

  /* Narrowest phones: short-form legal strings. */
  @media (width < 410px) {
    .footer-legal {
      gap: 10px;
      font-size: 10.5px;
    }
    .legal-long {
      display: none;
    }
    .legal-short {
      display: inline;
    }
  }
</style>

<script>
  /* Contact's CTA subtracts this footer's height from its screen-filling
     min-height so the pair still shares the final viewport now that the
     footer sits outside <main> (a landmark needs a body-level <footer>).
     Same measured-custom-property pattern as Header's --headerH; the
     observer's initial pre-paint delivery replaces the 0px fallback in
     global.css. */
  const footer = document.getElementById("site-footer");
  if (footer) {
    new ResizeObserver((entries) => {
      const size = entries[0]?.borderBoxSize[0];
      if (size) {
        document.documentElement.style.setProperty(
          "--footerH",
          `${size.blockSize}px`,
        );
      }
    }).observe(footer);
  }
</script>
