---
import { sectionHrefFrom, sections } from "../lib/nav";
import ContactCta from "./ContactCta.astro";
import ThemeToggle from "./ThemeToggle.astro";

/* In-page hashes on the home page, where the scroll-spy below keys off
   `a[href^="#"]`; home-first anywhere else, where the spy, matching nothing,
   highlights nothing. */
const linkTo = sectionHrefFrom(Astro.url.pathname);
---

{
  /* Ships with the nav rather than with Base: the link exists because there is
    a nav to skip, and the chrome-less 404 has none. Its target is the page's
    <main id="main"> — the one contract this component has with its page. */
}
<a href="#main" class="skip-link sr-only focus:not-sr-only">Skip to content</a>
<header
  id="site-header"
  class="sticky top-0 z-10 mx-auto grid max-w-page grid-cols-[minmax(0,1fr)_auto] items-center bg-bg"
>
  <nav aria-label="Main" class="flex flex-wrap items-center">
    {
      sections.map(({ id, label }) => (
        <a href={linkTo(id)} class="border-b border-transparent pb-0.5">
          {label}
        </a>
      ))
    }
  </nav>
  <div class="header-actions flex items-center">
    <ThemeToggle />
    <ContactCta compact />
  </div>
</header>

<style>
  /* Tier rules per docs/architecture.md; 900/700/460 =
     tablet/phone/phone-sm. */

  /* focus:not-sr-only restores the link to the flow (position: static); this
     lifts it out again so it can't displace the header. It wins because
     component styles are unlayered while Tailwind's utilities are layered. */
  .skip-link:focus {
    position: fixed;
    z-index: 20;
    top: 8px;
    left: 8px;
    background: var(--bg);
    padding: 10px 16px;
    font-size: var(--text-meta);
  }

  header {
    gap: 32px;
    padding-block: 20px;
    padding-inline: 36px;
  }
  nav {
    gap: 26px;
    font-size: var(--text-meta);
  }
  .header-actions {
    gap: 20px;
  }
  /* The slow fade makes the highlight glide between links as scrolling hands
     one section's ownership of the viewport to the next.

     Off during a theme flip: these colours come from --ink/--accent-text, and
     the flip animates those tokens directly (global.css), so a transition here
     would chase a value that moves every frame and land ~600ms after the page
     does. The theme fade owns the colour; this rule owns the highlight. */
  :global(html:not(.theme-switching)) nav a {
    transition:
      color 700ms ease,
      border-color 700ms ease;
  }
  nav a[aria-current] {
    color: var(--accent-text);
    border-bottom-color: currentColor;
  }

  /* Tablet: tighter chrome all round. */
  @media (width < 900px) {
    header {
      gap: 16px;
      padding-block: 14px;
      padding-inline: 20px;
    }
    nav {
      gap: 18px;
    }
    .header-actions {
      gap: 14px;
      white-space: nowrap;
    }
  }

  /* Tablet band only: the nav and the actions still share one row here, so
     the links step down to fit. Below 700 the nav wraps to a line of its own
     and regains the full meta size — hence a band rather than a step. */
  @media (700px <= width < 900px) {
    nav {
      font-size: 12px;
    }
  }

  /* Phone: the header keeps shrinking while the nav, now on its own line,
     opens back up. */
  @media (width < 700px) {
    header {
      padding-block: 12px;
      padding-inline: 16px;
    }
    nav {
      gap: 16px;
    }
  }

  /* Small phones: the nav holds one line rather than wrapping. */
  @media (width < 460px) {
    header {
      gap: 12px;
    }
    nav {
      flex-wrap: nowrap;
      gap: 14px;
      font-size: 12px;
    }
  }
</style>

<script>
  const header = document.getElementById("site-header");
  if (header) {
    /* Highlight the nav link for the section that owns the viewport: the one
       whose box spans the point just below the header. Sections that aren't
       built yet simply never match. Links are tracked by their #hash — the
       one identity a link and its section share. */
    const navTargets = [
      ...header.querySelectorAll<HTMLAnchorElement>('nav a[href^="#"]'),
    ].map((link) => ({
      link,
      section: document.getElementById(link.hash.slice(1)),
    }));
    /* The first nav link whose section is actually on the page — not simply
       the first link, which would park the highlight on a link to nothing
       until a real section top crossed the probe. */
    const defaultHash = navTargets.find(({ section }) => section)?.link.hash;
    /* The hashes the highlight may lock onto: nav links whose section exists.
       The skip link's #main resolves to a real element but to no nav link, so
       locking onto it would blank every link until the lock expired. */
    const lockableHashes = new Set(
      navTargets.filter(({ section }) => section).map(({ link }) => link.hash),
    );

    let headerHeight = 0;
    let lockedHash: string | null = null;
    let lockTimeout: ReturnType<typeof setTimeout> | undefined;
    let lastActive: string | undefined;

    const syncActiveNav = () => {
      let activeHash = lockedHash ?? defaultHash;
      if (!lockedHash) {
        const probeY = headerHeight + 8;
        /* Last section whose top has passed the probe wins — so scrolling
           into the footer (below the last section) keeps Contact active. */
        for (const { link, section } of navTargets) {
          if (!section) continue;
          if (section.getBoundingClientRect().top <= probeY) {
            activeHash = link.hash;
          }
        }
      }
      if (activeHash === lastActive) return;
      lastActive = activeHash;
      for (const { link } of navTargets) {
        if (link.hash === activeHash) {
          link.setAttribute("aria-current", "location");
        } else {
          link.removeAttribute("aria-current");
        }
      }
    };

    let syncQueued = false;
    const queueSync = () => {
      if (syncQueued) return;
      syncQueued = true;
      requestAnimationFrame(() => {
        syncQueued = false;
        syncActiveNav();
      });
    };

    /* Section heights (`section-screen`) and the anchor scroll offset both
       depend on the header's real (content-driven) height, and the sticky
       header's top edge is always 0, so this height is also the probe origin
       syncActiveNav needs — one measurement serves both. The observer fires
       once on observe() — before first paint — so no eager measurement is
       needed and its initial delivery is the init sync. */
    new ResizeObserver((entries) => {
      const size = entries[0]?.borderBoxSize[0];
      if (size) {
        headerHeight = size.blockSize;
        document.documentElement.style.setProperty(
          "--headerH",
          `${size.blockSize}px`,
        );
        queueSync();
      }
    }).observe(header);

    /* While an in-page anchor click's smooth scroll is in flight, the target
       owns the highlight, so it moves at the same moment whichever direction
       the scroll comes from. Browsers neither expose smooth-scroll duration
       nor let an author set it, so the lock is an upper-bound guess chosen to
       outlast the scroll rather than a measured value. */
    const SMOOTH_SCROLL_LOCK_MS = 900;
    document.addEventListener("click", (event) => {
      /* Only a plain left click scrolls this page. A modified or non-primary
         click opens a new tab and leaves the current scroll where it was, so
         locking the highlight would strand it on the wrong link for the full
         lock duration. */
      if (
        event.defaultPrevented ||
        event.button !== 0 ||
        event.metaKey ||
        event.ctrlKey ||
        event.shiftKey ||
        event.altKey
      ) {
        return;
      }
      const link =
        event.target instanceof Element
          ? event.target.closest<HTMLAnchorElement>('a[href^="#"]')
          : null;
      if (!link || !lockableHashes.has(link.hash)) return;
      lockedHash = link.hash;
      clearTimeout(lockTimeout);
      lockTimeout = setTimeout(() => {
        lockedHash = null;
        syncActiveNav();
      }, SMOOTH_SCROLL_LOCK_MS);
      syncActiveNav();
    });

    window.addEventListener("scroll", queueSync, { passive: true });
    window.addEventListener("resize", queueSync);
  }
</script>
