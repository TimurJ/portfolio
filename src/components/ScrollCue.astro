---
import { type SectionHref } from "../lib/nav";

interface Props {
  href: SectionHref;
  /** Extra utilities for the consumer's context (placement, responsive size). */
  class?: string;
}

const { href, class: className } = Astro.props;
---

<a href={href} class:list={["text-meta text-muted", className]}>
  Scroll Down ↓
</a>
