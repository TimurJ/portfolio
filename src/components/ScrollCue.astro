---
interface Props {
  /** Scroll-cue target: the next section, owned by the page's composition. */
  href: string;
  /** Extra utilities for the consumer's context (placement, responsive size). */
  class?: string;
}

const { href, class: className } = Astro.props;
---

<a href={href} class:list={["text-[13px] text-muted", className]}>
  Scroll Down ↓
</a>
