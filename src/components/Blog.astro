---
import { formatMonthYear, isoDate } from "../lib/dates";
import { iconAttrs } from "../lib/icons";
import { getPosts, postHref, readingTimeOf } from "../lib/posts";
import DotLabel from "./DotLabel.astro";
import Section from "./Section.astro";

/* The one section whose content is a collection rather than a typed const:
   the same list feeds the article route, so a card and its page can't drift. */
const posts = await getPosts();
/* The row is one link, named by its title alone — see aria-labelledby. */
const titleId = (id: string) => `blog-${id}-title`;
---

<Section
  id="blog"
  eyebrow="Blog"
  title="Explore My Blog"
  blurb="These are the findings I’ve collected building frontends in finance: trading screens, market data, design systems. I write them up as I go so the insights are useful to someone other than me."
>
  {
    posts.map((post) => (
      <a
        href={postHref(post)}
        aria-labelledby={titleId(post.id)}
        class="blog-row grid items-start border-b border-hair"
      >
        <div class="blog-meta text-muted">
          <DotLabel>
            <time datetime={isoDate(post.data.pubDate)}>
              {formatMonthYear(post.data.pubDate)}
            </time>
          </DotLabel>
          <span>{readingTimeOf(post)} min read</span>
        </div>
        <div class="flex min-w-0 flex-col gap-3">
          <h3
            id={titleId(post.id)}
            class="blog-title leading-[1.15] font-normal tracking-[-0.02em]"
          >
            {post.data.title}
          </h3>
          <p class="blog-excerpt max-w-[62ch] text-pretty text-muted">
            {post.data.description}
          </p>
          <span class="blog-cta self-start border-b border-accent-text/40 pb-0.5 text-meta text-accent-text">
            Read article
          </span>
        </div>
        <svg class="blog-arrow" {...iconAttrs(30, 1.3)}>
          <path d="M7 17 17 7" />
          <path d="M8 7h9v9" />
        </svg>
      </a>
    ))
  }
</Section>

<style>
  /* Tier rules per docs/architecture.md; 1100/900/700 =
     laptop/tablet/phone. */

  .blog-row {
    grid-template-columns: minmax(0, 3fr) minmax(0, 10fr) auto;
    column-gap: 32px;
    padding: clamp(22px, 3.6vh, 40px) 0;
  }
  .blog-meta {
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-size: var(--text-body);
    line-height: 1.2;
    margin-top: 5px;
  }
  .blog-title {
    font-size: clamp(20px, 2vw, 30px);
  }
  .blog-excerpt {
    font-size: var(--text-body);
    line-height: 1.55;
  }
  /* Hover transitions, and hover only: they are off during a theme flip, which
     animates the --ink/--accent-text tokens these read and would otherwise be
     chased frame by frame (the contract is stated in global.css). */
  :global(html:not(.theme-switching)) .blog-title,
  :global(html:not(.theme-switching)) .blog-cta {
    transition:
      color 200ms ease,
      border-color 200ms ease;
  }
  .blog-arrow {
    margin-top: 16px;
  }
  :global(html:not(.theme-switching)) .blog-arrow {
    transition:
      translate 450ms cubic-bezier(0.16, 1, 0.3, 1),
      color 250ms ease;
  }
  /* Hover gated as Tailwind gates its hover: variants — no sticky hover on touch. */
  @media (hover: hover) {
    .blog-row:hover .blog-title {
      color: var(--accent-text);
    }
    .blog-row:hover .blog-arrow {
      color: var(--accent-text);
      translate: 12px -12px;
    }
    .blog-row:hover .blog-cta {
      border-color: var(--accent-text);
    }
  }

  /* Laptop: tighter rows and type. */
  @media (width < 1100px) {
    .blog-row {
      padding: 18px 0;
    }
    .blog-title {
      font-size: 22px;
    }
    .blog-excerpt {
      font-size: 14px;
      line-height: 1.5;
    }
  }

  /* Narrow tablet: the meta column becomes a horizontal line above the title. */
  @media (width < 900px) {
    .blog-row {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 10px 20px;
    }
    .blog-meta {
      grid-column: 1 / -1;
      flex-direction: row;
      align-items: center;
      gap: 18px;
      margin-top: 0;
      font-size: 14px;
    }
  }

  /* Phone: smaller type, tighter rows. */
  @media (width < 700px) {
    .blog-row {
      padding: 16px 0;
    }
    .blog-title {
      font-size: 19px;
    }
    .blog-excerpt {
      font-size: 13px;
    }
  }
</style>
