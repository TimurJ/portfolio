---
import { iconAttrs } from "../lib/icons";
import { type SectionHref, type SectionId } from "../lib/nav";
import ScrollCue from "./ScrollCue.astro";
import SectionIntro from "./SectionIntro.astro";

interface Props {
  /** Scroll-cue target: the next section, owned by the page's composition. */
  nextHref: SectionHref;
}

type BlogEntry = {
  date: string;
  readTime: string;
  title: string;
  excerpt: string;
};

const posts: BlogEntry[] = [
  {
    date: "June 2026",
    readTime: "7 min read",
    title: "Rendering a live order book without dropping frames",
    excerpt:
      "What actually costs you a frame when prices update forty times a second, and why virtualisation is the last optimisation to reach for rather than the first.",
  },
  {
    date: "March 2026",
    readTime: "11 min read",
    title: "Design systems that survive a trading desk",
    excerpt:
      "Colour rules for profit and loss, density that traders will accept, and the governance needed to keep one component library serving six teams.",
  },
  {
    date: "November 2025",
    readTime: "9 min read",
    title: "WebSockets, reconnects and the state you forgot to reconcile",
    excerpt:
      "A pattern for streaming market data that keeps the client honest after a dropped connection, and the tests that prove it.",
  },
];

const sectionId: SectionId = "blog";
const { nextHref } = Astro.props;
---

<section id={sectionId} class="section-screen mx-auto flex max-w-page flex-col">
  <SectionIntro
    eyebrow="Blog"
    title="Explore My Blog"
    blurb="These are the findings I've collected building front ends in finance: trading screens, market data, design systems. I write them up as I go so the insights are useful to someone other than me."
  />
  <div class="section-list">
    {
      posts.map(({ date, readTime, title, excerpt }) => (
        <article class="blog-row grid items-start border-b border-hair">
          <div class="blog-meta text-muted">
            <span class="inline-flex items-center gap-[9px]">
              <span class="size-1.5 flex-none rounded-full bg-dot" />
              {date}
            </span>
            <span>{readTime}</span>
          </div>
          <div class="flex min-w-0 flex-col gap-3">
            <h3 class="blog-title leading-[1.15] font-normal tracking-[-0.02em]">
              {title}
            </h3>
            <p class="blog-excerpt max-w-[62ch] text-pretty text-muted">
              {excerpt}
            </p>
            <span class="blog-cta self-start border-b border-accent-text/40 pb-0.5 text-[13px] text-accent-text">
              Read article
            </span>
          </div>
          <svg class="blog-arrow" {...iconAttrs(30, 1.3)}>
            <path d="M7 17 17 7" />
            <path d="M8 7h9v9" />
          </svg>
        </article>
      ))
    }
  </div>
  <div class="section-cue">
    <ScrollCue href={nextHref} />
  </div>
</section>

<style>
  /* Per-tier rules live here per the styling policy (docs/architecture.md);
     1100/900/700 are --breakpoint-laptop/--breakpoint-tablet/
     --breakpoint-phone written out. */

  .blog-row {
    grid-template-columns: minmax(0, 3fr) minmax(0, 10fr) auto;
    column-gap: 32px;
    padding: clamp(22px, 3.6vh, 40px) 0;
  }
  .blog-meta {
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-size: 15px;
    line-height: 1.2;
    margin-top: 5px;
  }
  .blog-title {
    font-size: clamp(20px, 2vw, 30px);
  }
  .blog-excerpt {
    font-size: 15px;
    line-height: 1.55;
  }
  .blog-title,
  .blog-cta {
    transition:
      color 200ms ease,
      border-color 200ms ease;
  }
  .blog-arrow {
    margin-top: 16px;
    transition:
      translate 450ms cubic-bezier(0.16, 1, 0.3, 1),
      color 250ms ease;
  }
  /* Hover gated as Tailwind gates its hover: variants — no sticky hover on touch. */
  @media (hover: hover) {
    .blog-row:hover .blog-title {
      color: var(--accent-text);
    }
    .blog-row:hover .blog-arrow {
      color: var(--accent-text);
      translate: 12px -12px;
    }
    .blog-row:hover .blog-cta {
      border-color: var(--accent-text);
    }
  }

  /* Laptop: tighter rows and type. */
  @media (width < 1100px) {
    .blog-row {
      padding: 18px 0;
    }
    .blog-title {
      font-size: 22px;
    }
    .blog-excerpt {
      font-size: 14px;
      line-height: 1.5;
    }
  }

  /* Narrow tablet: the meta column becomes a horizontal line above the title. */
  @media (width < 900px) {
    .blog-row {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 10px 20px;
    }
    .blog-meta {
      grid-column: 1 / -1;
      flex-direction: row;
      align-items: center;
      gap: 18px;
      margin-top: 0;
      font-size: 14px;
    }
  }

  /* Phone: smaller type, tighter rows. */
  @media (width < 700px) {
    .blog-row {
      padding: 16px 0;
    }
    .blog-title {
      font-size: 19px;
    }
    .blog-excerpt {
      font-size: 13px;
    }
  }
</style>
