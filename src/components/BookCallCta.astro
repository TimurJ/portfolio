---
import { hrefOf } from "../lib/nav";

interface Props {
  /** Tight chrome context (the header): steps the type down on small phones. */
  compact?: boolean;
  /** Extra width-invariant utilities for the consumer's context (placement). */
  class?: string;
}

const { compact, class: className } = Astro.props;
---

<a
  href={hrefOf("contact")}
  class:list={["border-b border-line pb-0.5 text-meta", { compact }, className]}
>
  {
    /* ↓, not the design's ↗: this is an in-page jump to #contact, and ↗ is
      reserved for links that leave the page (see Footer's external links). */
  }
  Book A Call ↓
</a>

<style>
  /* Tier rule per docs/architecture.md; 460 is the phone-sm tier. The header's
     row is at its tightest there, so its copy of the CTA steps down with the
     nav beside it. */
  @media (width < 460px) {
    .compact {
      font-size: 12px;
    }
  }
</style>
