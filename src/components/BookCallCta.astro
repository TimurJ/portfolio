---
interface Props {
  /** Extra utilities for the consumer's context (placement, responsive size). */
  class?: string;
}

const { class: className } = Astro.props;
---

<a
  href="#contact"
  class:list={["border-b border-line pb-0.5 text-[13px]", className]}
>
  {
    /* ↓, not the design's ↗: this is an in-page jump to #contact, and ↗ is
      reserved for links that leave the page (see Footer's external links). */
  }
  Book A Call ↓
</a>
