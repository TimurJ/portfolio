---
import { iconAttrs } from "../lib/icons";
---

{
  /* The state-flipping visible text is the accessible name ("Dark theme" /
    "Light theme") — per the ARIA APG, a toggle whose label changes with its
    state conveys the state through the label alone, with no aria-pressed. */
}
<button
  type="button"
  data-theme-toggle
  class="flex cursor-pointer items-center gap-2 text-[13px] hover:text-accent-text max-phone-sm:-m-[13px] max-phone-sm:p-[13px]"
>
  <svg {...iconAttrs(17, 1.6)} class="dark:hidden">
    <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
  </svg>
  <svg {...iconAttrs(17, 1.6)} class="hidden dark:block">
    <circle cx="12" cy="12" r="4"></circle>
    <path
      d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
    ></path>
  </svg>
  <span class="max-phone-sm:sr-only">
    <span class="dark:hidden">Dark<span class="sr-only"> theme</span></span>
    <span class="hidden dark:inline"
      >Light<span class="sr-only"> theme</span></span
    >
  </span>
</button>

<script>
  import { THEME_ATTRIBUTE, THEME_STORAGE_KEY } from "../lib/theme";

  /* The --theme-fade transition in global.css applies only while
     .theme-switching is on the root, so it runs exactly for the flip and
     never on hover or load. The removal timeout derives from the same token
     (plus a settle margin) so it always outlasts the fade. */
  const root = document.documentElement;
  const fadeMs =
    parseFloat(getComputedStyle(root).getPropertyValue("--theme-fade")) || 500;
  let switchTimeout: ReturnType<typeof setTimeout>;

  document
    .querySelectorAll<HTMLButtonElement>("[data-theme-toggle]")
    .forEach((button) => {
      button.addEventListener("click", () => {
        const next =
          root.getAttribute(THEME_ATTRIBUTE) === "dark" ? "light" : "dark";
        root.classList.add("theme-switching");
        clearTimeout(switchTimeout);
        switchTimeout = setTimeout(
          () => root.classList.remove("theme-switching"),
          fadeMs + 60,
        );
        if (next === "dark") {
          root.setAttribute(THEME_ATTRIBUTE, "dark");
        } else {
          root.removeAttribute(THEME_ATTRIBUTE);
        }
        try {
          localStorage.setItem(THEME_STORAGE_KEY, next);
        } catch {
          // no storage access — the choice simply won't persist
        }
      });
    });
</script>
