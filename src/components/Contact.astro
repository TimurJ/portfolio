---
import { type SectionId, titleIdOf } from "../lib/nav";
import { mailto } from "../lib/site";
import SectionIntro from "./SectionIntro.astro";

const sectionId: SectionId = "contact";
const titleId = titleIdOf(sectionId);
---

<section
  id={sectionId}
  aria-labelledby={titleId}
  class="contact-screen flex flex-col"
>
  <SectionIntro
    closer
    titleId={titleId}
    class="mx-auto w-full max-w-page flex-1 content-center"
    eyebrow="Contact"
    title="Let’s Start a Conversation"
    blurb="Whether it’s a question about the work here, a problem you’re weighing up, or just a conversation worth having, my inbox is open. I read everything and reply within a couple of days."
  >
    {
      /* One CTA, not two: the section's only action is to open a mail client,
        and a second link on the same mailto would be the same button twice.
        It fills the slot directly — self-start because the intro's aside is a
        column flex, and a stretched item would run the button to the aside's
        full width (the default CTA in this slot carries it for the same
        reason). */
    }
    <a
      href={mailto}
      slot="cta"
      class="contact-btn inline-flex items-center gap-3 self-start bg-accent px-[22px] py-3.5 text-meta tracking-[0.02em] text-white hover:bg-accent-hover"
    >
      Get in Touch ↗
    </a>
  </SectionIntro>
</section>

<style>
  .contact-screen {
    /* The section and the site footer (a sibling of <main>, so it can be a
       contentinfo landmark) still share the final viewport: subtract the
       footer's measured height (--footerH, owned by Footer.astro) as well as
       the header's from the screen-filling formula section-screen uses. */
    min-height: calc(100svh - var(--headerH) - var(--footerH));
  }
  /* The design's `ease`, which transition-colors' default curve isn't. Only the
     background moves on hover — the text is pinned white. Off during a theme
     flip, which animates the --accent this reads (see global.css); the two
     accents are near-identical so nothing shows, but the rule is the same one
     the other components follow. */
  :global(html:not(.theme-switching)) .contact-btn {
    transition: background-color 220ms ease;
  }
</style>
